  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_DaBDlGYUEe66PO4-uOcMFw" sourceConnectionVisual="_DaBqoGYUEe66PO4-uOcMFw" text="Updates priority and release time of &#xA;&#x9; * this activation.&lt;br>&#xA;&#x9; * &#xA;&#x9; * The priority of the element is equal to the&#xA;&#x9; * edge priority with the earliest release time.&#xA;&#x9; * Thus, it can change dynamically. &lt;br>&#xA;&#x9; *&#xA;&#x9; * The release time of the element is equal to the&#xA;&#x9; * edge priority with the earliest release time.&#xA;&#x9; * Thus, it can change dynamically. &lt;br>" item="_DaI_s2YUEe66PO4-uOcMFw">
    <modelElement href="ScheduleableObject.uml#_0Lg5E2YTEe66PO4-uOcMFw"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_DaBqoWYUEe66PO4-uOcMFw" sourceConnectionVisual="_DaBqomYUEe66PO4-uOcMFw" text="getNextScheduleTime returns the next entry in the additional&#xA;&#x9; * schedule time array list whose start time is greater than the input&#xA;&#x9; * parameter time. MAX_INT is returned if such a time&#xA;&#x9; * is not found&#xA;&#x9; * @param next&#xA;&#x9; * @param time&#xA;&#x9; * @return next schedule time or MAX_VALUEs if not found" item="_DaI_xWYUEe66PO4-uOcMFw">
    <modelElement href="ScheduleableObject.uml#_0Lg5FWYTEe66PO4-uOcMFw"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_DaCRsGYUEe66PO4-uOcMFw" sourceConnectionVisual="_DaCRsWYUEe66PO4-uOcMFw" text="getMatchingEndTime returns the next end time in the additional&#xA;&#x9; * schedule time array list that is greater than the input&#xA;&#x9; * parameter time. MAX_INT is returned if such a time&#xA;&#x9; * is not found&#xA;&#x9; * @param next&#xA;&#x9; * @param time&#xA;&#x9; * @return next start time or MAX_VALUE if not found" item="_DaI_zWYUEe66PO4-uOcMFw">
    <modelElement href="ScheduleableObject.uml#_0Lg5FmYTEe66PO4-uOcMFw"/>
  </nodes>
