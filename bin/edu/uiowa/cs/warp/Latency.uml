                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>if (v1 &lt; v2)
			return -1; 
		else if (v1 > v2)
			return 1; 
		return 0; // tied: values are the same 
	</body>
              </ownedBehavior>
