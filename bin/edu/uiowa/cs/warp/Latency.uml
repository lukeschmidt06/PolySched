                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>T element = null;
		E fullRow;
		if (row &lt; this.size()) {
			fullRow = this.get(row);
			if (column &lt; fullRow.size()) {
				element = fullRow.get(column);
			}
		}
		return element;
	</body>
