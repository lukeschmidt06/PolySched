              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCwzzmYXEe6uL7xt-YnTxg" name="toString" specification="_b97W6mYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCwzz2YXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
