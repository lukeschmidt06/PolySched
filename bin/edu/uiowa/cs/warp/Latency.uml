              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCqGEWYXEe6uL7xt-YnTxg" name="Program" specification="_cCDB4WYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCqGEmYXEe6uL7xt-YnTxg" name="workLoad" type="_b913UGYXEe6uL7xt-YnTxg"/>
