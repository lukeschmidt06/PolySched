	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cClNhWYXEe6uL7xt-YnTxg" name="getNextScheduleTime" specification="_b8-UrWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cClNhmYXEe6uL7xt-YnTxg" name="time">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cClNh2YXEe6uL7xt-YnTxg" type="_b9n04GYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>var result = new ScheduleTime(Integer.MAX_VALUE, Integer.MAX_VALUE);
		var moreScheduleTimes = getAdditionalScheduleTimes();
		Iterator&lt;ScheduleTime> iter = moreScheduleTimes.iterator();
		while (iter.hasNext() ) {
			var next = iter.next();
			if (next.getStartTime() > time) {
				result = next;
				break;
			}
		}
		return result;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cClNiGYXEe6uL7xt-YnTxg" name="getMatchingEndTime" specification="_b8-7sGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cClNiWYXEe6uL7xt-YnTxg" name="time">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cClNimYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>var result = Integer.MAX_VALUE;
		var moreScheduleTimes = getAdditionalScheduleTimes();
		Iterator&lt;ScheduleTime> iter = moreScheduleTimes.iterator();
		// var nextEndTime = time;
		while (iter.hasNext()) { //  &amp;&amp; nextEndTime &lt;= time  ) {
			// nextEndTime = iter.next().getEndTime();
			var scheduleTime = iter.next();
			if (time == scheduleTime.getStartTime()) {
				result = scheduleTime.getEndTime();
				break;
			}
		}
		
		return result;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0cGYXEe6uL7xt-YnTxg" name="getNextStartTime" specification="_b8-7s2YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0cWYXEe6uL7xt-YnTxg" name="time">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCl0cmYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>var moreScheduleTimes = getAdditionalScheduleTimes();
		Iterator&lt;ScheduleTime> iter = moreScheduleTimes.iterator();
		var nextStartTime = time;
		while (iter.hasNext() &amp;&amp; nextStartTime &lt;= time  ) {
			nextStartTime = iter.next().getStartTime();
		}
		if (nextStartTime == time) {
			/* no next StartTime found 
			 * could be an error 
			 */
			nextStartTime = Integer.MAX_VALUE;
			
		}
		return nextStartTime;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0c2YXEe6uL7xt-YnTxg" name="getNextEndTime" specification="_b8-7tmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0dGYXEe6uL7xt-YnTxg" name="time">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCl0dWYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>var moreScheduleTimes = getAdditionalScheduleTimes();
		Iterator&lt;ScheduleTime> iter = moreScheduleTimes.iterator();
		var nextEndTime = time;
		while (iter.hasNext() &amp;&amp; nextEndTime &lt;= time  ) {
			nextEndTime = iter.next().getEndTime();
		}
		if (nextEndTime == time) {
			/* no next StartTime found 
			 * could be an error 
			 */
			nextEndTime = Integer.MAX_VALUE;
			
		}
		return nextEndTime;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0dmYXEe6uL7xt-YnTxg" name="getNumEdges" specification="_b8-7uWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0d2YXEe6uL7xt-YnTxg" direction="return">
