              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0eGYXEe6uL7xt-YnTxg" name="compareTo" specification="_cBPwpmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0eWYXEe6uL7xt-YnTxg" name="obj" type="_b89GgWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCl0emYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>return priorityComparison(obj);
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0e2YXEe6uL7xt-YnTxg" name="conflictExists" specification="_cBPwrGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0fGYXEe6uL7xt-YnTxg" name="obj" type="_b89GgWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCl0fWYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
                </ownedParameter>
                <language>java</language>
                <body>Boolean result = false;
		/* create a copy of this.conflicts and obj.conflicts
		 * and then check the intersection of the two 
		 * sets. 
		 * Conflicts exists if |intersection| > 0
		 */
		var conflicts = new HashSet&lt;String>();
		conflicts.addAll(getConflicts());
		var objConflicts = new HashSet&lt;String>();
		objConflicts.addAll(obj.getConflicts());
		conflicts.retainAll(objConflicts); // get the intersection
		if (conflicts.size() > 0) {
			result = true; // |intersection| > 0 => conflict
		}
		return result;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0fmYXEe6uL7xt-YnTxg" name="canCombine" specification="_cBPwr2YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0f2YXEe6uL7xt-YnTxg" name="a2" type="_b89GgWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCl0gGYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
                </ownedParameter>
                <language>java</language>
                <body>Boolean result = false;
		/* make sure a2 is not null */
		if (a2 != null) {
			var newEntryCoordinator = a2.getCoordinators().get(0);
			if (getCoordinators().contains(newEntryCoordinator)) {
				/* The (first) coordinator of the newEntry
				 * is in the list of coordinators of the prior entry.
				 * Thus, these two can be combined for efficiency.
				 */
				result = true;
			}
		}
		return result;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0gWYXEe6uL7xt-YnTxg" name="getDelta" specification="_b8-7u2YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0gmYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>Integer maxTxPerLink = 0;
		for (Edge edge: getEdges()) {
			maxTxPerLink = Math.max(maxTxPerLink, edge.getNumTx());
		}
		return maxTxPerLink;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0g2YXEe6uL7xt-YnTxg" name="getExecutionDuration" specification="_b8-7vWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0hGYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>/* Each edge requires delta time units. However, assuming 
		 * the WARP pipeline scheduling approach, the activation only
		 * executes for Delta + (numEdges - 1) time units, because
		 * a new edge will be added to the pipeline every time unit
		 * it executes.
		 */
		return getDelta() + (getNumEdges() - 1);
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0hWYXEe6uL7xt-YnTxg" name="getCombinedExecutionDuration" specification="_cBPwsmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0hmYXEe6uL7xt-YnTxg" name="a2" type="_b89GgWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCl0h2YXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>/* Each edge requires delta time units. However, assuming 
		 * the WARP pipeline scheduling approach, the activation only
		 * executes for Delta + (numEdges - 1) time units, because
		 * a new edge will be added to the pipeline every time unit
		 * it executes.
		 * So, if combined, we consider edges in both activations
		 */
		var result = 0;
		if (a2 != null) {
			result = Math.max(getDelta(), a2.getDelta()) + (getNumEdges() + a2.getNumEdges() - 1);
		}
		return result;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0iGYXEe6uL7xt-YnTxg" name="printAll" specification="_b8-7v2YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0iWYXEe6uL7xt-YnTxg" name="headerMsg">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <language>java</language>
                <body>System.out.printf(&quot;\n%s&quot;,headerMsg);
		this.printAll();
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0imYXEe6uL7xt-YnTxg" name="printAll" specification="_b8-7wWYXEe6uL7xt-YnTxg">
                <language>java</language>
                <body>super.print();
		printEdges(&quot;Parition &quot;+getName(),new ReleaseTimeQueue&lt;Edge>(edges));
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0i2YXEe6uL7xt-YnTxg" name="printEdges" specification="_cBPwtWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0jGYXEe6uL7xt-YnTxg" name="header">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCl0jWYXEe6uL7xt-YnTxg" name="edges" type="_b9dc0GYXEe6uL7xt-YnTxg"/>
                <language>java</language>
                <body>System.out.printf(&quot;\n%s\nEdges in edge list:&quot;, header);
		printEdges(edges);
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCl0jmYXEe6uL7xt-YnTxg" name="printEdges" specification="_cBQXsWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCl0j2YXEe6uL7xt-YnTxg" name="edges" type="_b9dc0GYXEe6uL7xt-YnTxg"/>
                <language>java</language>
                <body>var q = new ReleaseTimeQueue&lt;Edge>();
 		q.addAll(edges);
 		Iterator&lt;Edge> qValue = q.iterator();
         while (qValue.hasNext()) {
         	var next = q.poll();
         	next.print();
         }
	</body>
              </ownedBehavior>
