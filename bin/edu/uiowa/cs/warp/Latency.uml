                <language>java</language>
                <body>super();
		setName(name);
		this.edges = new ArrayList&lt;Edge>();
		this.coordinators = new ArrayList&lt;String>();
		this.conflicts = new HashSet&lt;String>();
		this.additionalScheduleTimes = new ArrayList&lt;ScheduleTime>();
	</body>
