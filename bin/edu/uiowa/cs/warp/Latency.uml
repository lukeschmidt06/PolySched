              </ownedOperation>
              <ownedOperation xmi:id="_b92eYmYXEe6uL7xt-YnTxg" name="getIntForFlowNames" method="_cCwMjmYXEe6uL7xt-YnTxg">
                <ownedComment xmi:id="_rwDcdJXmEe6MhezhJ-iEDA">
                  <body>@return the intForFlowNames</body>
                </ownedComment>
                <ownedParameter xmi:id="_b92eY2YXEe6uL7xt-YnTxg" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
                </ownedParameter>
              </ownedOperation>
              <ownedOperation xmi:id="_b92eZGYXEe6uL7xt-YnTxg" name="getName" method="_cCwMkGYXEe6uL7xt-YnTxg">
                <ownedComment xmi:id="_rwDcdZXmEe6MhezhJ-iEDA">
