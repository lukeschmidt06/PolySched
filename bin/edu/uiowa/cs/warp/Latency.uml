                <ownedParameter xmi:id="_cCmbi2YXEe6uL7xt-YnTxg" type="_b9CmE2YXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>this.delta = 0;
		this.channel = 0;
		this.edges = null;
		this.coordinator = null;
		this.codeFragment = new ArrayList&lt;String>();
		this.codeFragment.add(SLEEP);
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCmbjGYXEe6uL7xt-YnTxg" name="CodeFragment" specification="_cB7tIWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCmbjWYXEe6uL7xt-YnTxg" name="delta">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCmbjmYXEe6uL7xt-YnTxg" name="edges" type="_cBOigWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCmbj2YXEe6uL7xt-YnTxg" name="coordinators" type="_cBOigWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCmbkGYXEe6uL7xt-YnTxg" name="channel">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCmbkWYXEe6uL7xt-YnTxg" type="_b9CmE2YXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>this.delta = delta;
		this.channel = channel;
		this.edges = edges;
		this.coordinator = coordinators.get(0);
		this.codeFragment = new ArrayList&lt;String>();
		if (multipleCoordinators(coordinators)) {
			reportIfDifferentCoordinators(coordinators);
		}	
		generateCodeFragment();
	</body>
