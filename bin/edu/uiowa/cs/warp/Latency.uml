                <language>java</language>
                <body>this.name = UNKNOWN;
		this.priority = DEFAULT;
		this.period = DEFAULT_PERIOD;
		this.deadline = DEFAULT_DEADLINE;
		this.phase = DEFAULT;
		this.startTime = BEFORE_START;
		this.endTime = BEFORE_START;
