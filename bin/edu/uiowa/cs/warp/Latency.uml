            <packagedElement xmi:type="uml:Class" xmi:id="_b9JTx2YXEe6uL7xt-YnTxg" name="Flow">
              <ownedComment xmi:id="_rv_yH5XmEe6MhezhJ-iEDA">
                <body>Represents a flow in the system, both extending the SchedulableObject class
and implementing Comparable for flow comparisons.

Encapsulates information about the flow, including its name,
priority, index, number of transmissions per link, nodes, and edges.

@author sgoddard
 *</body>
              </ownedComment>
              <generalization xmi:id="_cBVQOmYXEe6uL7xt-YnTxg" general="_b9ggIGYXEe6uL7xt-YnTxg"/>
              <ownedAttribute xmi:id="_cCTgkGYXEe6uL7xt-YnTxg" name="UNDEFINED" visibility="private" isLeaf="true" isStatic="true" isReadOnly="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
