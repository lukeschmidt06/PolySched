     gv.addSnkNodeToGraphViz(nodeName);
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCoQ3WYXEe6uL7xt-YnTxg" name="exitFlow" specification="_cBZhr2YXEe6uL7xt-YnTxg">
