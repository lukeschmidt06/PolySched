              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCo3_2YXEe6uL7xt-YnTxg" name="Node" specification="_b9R2omYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCo4AGYXEe6uL7xt-YnTxg" name="name">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCo4AWYXEe6uL7xt-YnTxg" name="priority">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
