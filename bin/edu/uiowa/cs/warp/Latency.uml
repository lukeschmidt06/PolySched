                </ownedParameter>
                <language>java</language>
                <body>super(fm, warp, new String(title + &quot;Report&quot;), SUFFIX);
		this.content = content;
		this.title = title;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCr7LmYXEe6uL7xt-YnTxg" name="visualization" specification="_b9fSAWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCr7L2YXEe6uL7xt-YnTxg" type="_b9GQcmYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>return createReport();
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCr7MGYXEe6uL7xt-YnTxg" name="createReport" specification="_b9fSBWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCr7MWYXEe6uL7xt-YnTxg" type="_b9GQcmYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>Description report;
		if (content.size() > 0) {
			report = new Description(new String (title + &quot; Report&quot;));
			report.addAll(content);
		} else {
			report = new Description(new String (&quot;No &quot; + title + &quot; to report&quot;));
		}
		return report;
	</body>
              </ownedBehavior>
