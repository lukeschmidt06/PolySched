            <packagedElement xmi:type="uml:Class" xmi:id="_b9WvIGYXEe6uL7xt-YnTxg" name="PriorityComparator">
              <interfaceRealization xmi:id="_cCCa1WYXEe6uL7xt-YnTxg" client="_b9WvIGYXEe6uL7xt-YnTxg" supplier="_cBTbAWYXEe6uL7xt-YnTxg" contract="_cBTbAWYXEe6uL7xt-YnTxg"/>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCqGDWYXEe6uL7xt-YnTxg" name="compare" specification="_cCCa12YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCqGDmYXEe6uL7xt-YnTxg" name="obj1" type="_cB87SWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCqGD2YXEe6uL7xt-YnTxg" name="obj2" type="_cB87SWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCqGEGYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>var result = obj1.priorityComparison(obj2);
		if (result == 0) {
			// tied for priority, so break tie on release time
			result = obj1.releaseTimeComparison(obj2);
		}
		return result; // 0 => tie on priority and release time
	</body>
              </ownedBehavior>
              <ownedOperation xmi:id="_cCCa12YXEe6uL7xt-YnTxg" name="compare" method="_cCqGDWYXEe6uL7xt-YnTxg">
