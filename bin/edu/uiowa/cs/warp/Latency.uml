                </ownedParameter>
                <ownedParameter xmi:id="_cCqGF2YXEe6uL7xt-YnTxg" type="_b9WvImYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>setDefaultParameters(workLoad, nChannels, verbose, reportLatency);
 buildProgram(choice);
  </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCqGGGYXEe6uL7xt-YnTxg" name="Program" specification="_cCDB6mYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCqGGWYXEe6uL7xt-YnTxg" name="workLoad" type="_b913UGYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCqGGmYXEe6uL7xt-YnTxg" name="nChannels">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cCqGG2YXEe6uL7xt-YnTxg" name="choice" type="_cCCa3mYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCqGHGYXEe6uL7xt-YnTxg" type="_b9WvImYXEe6uL7xt-YnTxg" direction="return">
