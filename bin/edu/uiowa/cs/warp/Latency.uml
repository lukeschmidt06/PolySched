                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCaOTmYXEe6uL7xt-YnTxg" value="&quot;Reliability Analysis&quot;"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_cCaOT2YXEe6uL7xt-YnTxg" name="warp" visibility="private" type="_b9yM8GYXEe6uL7xt-YnTxg" association="_cDFjumYXEe6uL7xt-YnTxg"/>
