                <language>java</language>
                <body>var nodeName = ctx.getText(); // get the src node name
     gv.addSrcNodeToGraphViz(nodeName);
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCoQ22YXEe6uL7xt-YnTxg" name="exitSnkNode" specification="_cBZhqGYXEe6uL7xt-YnTxg">
