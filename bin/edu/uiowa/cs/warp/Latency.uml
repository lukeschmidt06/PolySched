            <packagedElement xmi:type="uml:Class" xmi:id="_b9PacGYXEe6uL7xt-YnTxg" name="LatencyAnalysis">
              <ownedComment xmi:id="__wLb4JYzEe6MhezhJ-iEDA">
                <body>LatencyAnalysis checks the latency (finishTime - releaseTime) for each
release of each flow for the WARP system. To be correct, the latency must be
less than or equal than the flows deadline parameter.

@author sgoddard
@version 1.6</body>
              </ownedComment>
              <ownedAttribute xmi:id="_cCVVzmYXEe6uL7xt-YnTxg" name="DEADLINE_MISS" visibility="private" isStatic="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCVVz2YXEe6uL7xt-YnTxg" value="&quot; => DEADLINE MISS&quot;"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_cCVV0WYXEe6uL7xt-YnTxg" name="FLOW_SEPARATOR" isStatic="true">
