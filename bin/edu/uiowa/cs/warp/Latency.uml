              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiNWYXEe6uL7xt-YnTxg" name="setPeriod" specification="_b9huSmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCsiNmYXEe6uL7xt-YnTxg" name="period">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>this.period = period;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiN2YXEe6uL7xt-YnTxg" name="setPhase" specification="_b9huTGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCsiOGYXEe6uL7xt-YnTxg" name="phase">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>this.phase = phase;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiOWYXEe6uL7xt-YnTxg" name="setNextReleaseTime" specification="_b9huTmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCsiOmYXEe6uL7xt-YnTxg" name="currentTime">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>if (currentTime >= lastUpdateTime) {
			// released every (j*period)+phase, for all j >=0
			Integer j = 0;
			if (period > 0) {
				j = (int) Math.ceil((double)currentTime/(double)period); // gives floor
			} 
			Integer nextRelease = (j*period)+phase ;
			releaseTime = nextRelease;
			lastUpdateTime = currentTime;
		}
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiO2YXEe6uL7xt-YnTxg" name="maxPhaseComparison" specification="_cBnkEWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCsiPGYXEe6uL7xt-YnTxg" name="obj2" type="_b9ggIGYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCsiPWYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>// for ascending order of priority
		return compareDescendingOrder(this.getDeadline(), obj2.getDeadline());
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiPmYXEe6uL7xt-YnTxg" name="maxPhaseComparison" specification="_cBnkFGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCsiP2YXEe6uL7xt-YnTxg" name="obj1" type="_b9ggIGYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCsiQGYXEe6uL7xt-YnTxg" name="obj2" type="_b9ggIGYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCsiQWYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>return obj1.maxPhaseComparison(obj2);
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCsiQmYXEe6uL7xt-YnTxg" name="deadlineComparison" specification="_cBnkGGYXEe6uL7xt-YnTxg">
