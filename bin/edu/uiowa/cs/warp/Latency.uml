                  <name xsi:nil="true"/>
                </ownedParameter>
                <language>java</language>
                <body>super();
		
		for(int i=0; i &lt; row; i++) {
			ArrayList&lt;E> nullRow = new ArrayList&lt;E>();
			for(int j=0; j &lt; column; j++) {
				nullRow.add(null);
			}
			this.add((E) nullRow);
		}
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCtwZmYXEe6uL7xt-YnTxg" name="getNumRows" specification="_b9pqHGYXEe6uL7xt-YnTxg">
