              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cClNg2YXEe6uL7xt-YnTxg" name="addScheduleTimes" specification="_cB7GEGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cClNhGYXEe6uL7xt-YnTxg" name="scheduleTime" type="_cBOigWYXEe6uL7xt-YnTxg"/>
