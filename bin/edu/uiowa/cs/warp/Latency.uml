              </ownedOperation>
              <ownedOperation xmi:id="_b9US5GYXEe6uL7xt-YnTxg" name="getNodesNamesOrderedAlphabetically" method="_cCpe9GYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_b9US5WYXEe6uL7xt-YnTxg" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                  <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_b9US5mYXEe6uL7xt-YnTxg" value="*"/>
                </ownedParameter>
              </ownedOperation>
              <ownedOperation xmi:id="_b9US6GYXEe6uL7xt-YnTxg" name="buildPosetOfActivations" method="_cCpe92YXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9US6WYXEe6uL7xt-YnTxg" name="createEdgeLists" visibility="private" method="_cCpe-GYXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9US6mYXEe6uL7xt-YnTxg" name="createConflictLists" visibility="private" method="_cCpe-WYXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9US62YXEe6uL7xt-YnTxg" name="createGlobalConflictLists" visibility="private" method="_cCpe-mYXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9US7GYXEe6uL7xt-YnTxg" name="createLocalConflictLists" visibility="private" method="_cCpe-2YXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9US7WYXEe6uL7xt-YnTxg" name="createInitialActivations" visibility="private" method="_cCpfA2YXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9U58GYXEe6uL7xt-YnTxg" name="getHyperPeriod" method="_cCpfC2YXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_b9U58WYXEe6uL7xt-YnTxg" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
              </ownedOperation>
              <ownedOperation xmi:id="_b9U58mYXEe6uL7xt-YnTxg" name="getMaxPhase" method="_cCpfDWYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_b9U582YXEe6uL7xt-YnTxg" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
              </ownedOperation>
              <ownedOperation xmi:id="_b9U59GYXEe6uL7xt-YnTxg" name="orderActivations" method="_cCqF4GYXEe6uL7xt-YnTxg"/>
              <ownedOperation xmi:id="_b9U59WYXEe6uL7xt-YnTxg" name="getNextActivation" method="_cCqF4WYXEe6uL7xt-YnTxg">
                <ownedComment xmi:id="_rwBAMZXmEe6MhezhJ-iEDA">
                  <body>getNextActivation returns the highest priority
	 * partition that has been released at or before input
	 * parameter time.
	 * 
	 * @param time
	 * @return</body>
                </ownedComment>
                <ownedParameter xmi:id="_cBfoQmYXEe6uL7xt-YnTxg" type="_b89GgWYXEe6uL7xt-YnTxg" direction="return"/>
              </ownedOperation>
              <ownedOperation xmi:id="_b9U59mYXEe6uL7xt-YnTxg" name="findBaseStation" visibility="protected" method="_cCqF5WYXEe6uL7xt-YnTxg">
                <ownedComment xmi:id="_rwBAM5XmEe6MhezhJ-iEDA">
                  <body>findBaseStation is used by algorithms that generate the
	 * partially ordered set of activations using a base station. 
	 * This method searches the set of flows to find the node that
	 * is always one of the src or snk nodes. In the case of a tie
	 * where there are two candidates the initial snk node is
	 * returned. If there are multiple base stations, only the fist
	 * one found is returned.
	 * 
	 * @return baseStation for the workload</body>
                </ownedComment>
                <ownedParameter xmi:id="_cBfoRWYXEe6uL7xt-YnTxg" type="_b9R2oWYXEe6uL7xt-YnTxg" direction="return"/>
              </ownedOperation>
              <ownedOperation xmi:id="_cBfBM2YXEe6uL7xt-YnTxg" name="Poset" visibility="package" method="_cCpe7WYXEe6uL7xt-YnTxg">
