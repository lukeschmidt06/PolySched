                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCVV02YXEe6uL7xt-YnTxg" value="&quot;******************************\n&quot;"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_cCV80GYXEe6uL7xt-YnTxg" name="latencyReport" visibility="private" type="_b9GQcmYXEe6uL7xt-YnTxg" association="_cDDHcGYXEe6uL7xt-YnTxg"/>
              <ownedAttribute xmi:id="_cCV81GYXEe6uL7xt-YnTxg" name="workload" visibility="private" type="_b913UGYXEe6uL7xt-YnTxg" association="_cDDHdmYXEe6uL7xt-YnTxg"/>
              <ownedAttribute xmi:id="_cCV81mYXEe6uL7xt-YnTxg" name="programTable" visibility="private" type="_b9bAkGYXEe6uL7xt-YnTxg" association="_cDDHeWYXEe6uL7xt-YnTxg"/>
