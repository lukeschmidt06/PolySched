              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCpe0GYXEe6uL7xt-YnTxg" name="compareTo" specification="_cBdzFGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCpe0WYXEe6uL7xt-YnTxg" name="node" type="_b9R2oWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cCpe0mYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#int"/>
                </ownedParameter>
                <language>java</language>
                <body>return node.getPriority() > this.getPriority() ? -1 : 1;
 </body>
              </ownedBehavior>
