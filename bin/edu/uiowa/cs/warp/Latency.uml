                </ownedParameter>
                <language>java</language>
                <body>return this.size();
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCtwaGYXEe6uL7xt-YnTxg" name="getNumColumns" specification="_b9pqHmYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCtwaWYXEe6uL7xt-YnTxg" direction="return">
                  <name xsi:nil="true"/>
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <language>java</language>
                <body>var numColumns = 0;
		var numRows = this.size();
		if (numRows > 0) {
			var lastRow = this.get(numRows-1);
			numColumns = lastRow.size();
		}
		return numColumns;
	</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_cCtwamYXEe6uL7xt-YnTxg" name="set" specification="_cCHTUGYXEe6uL7xt-YnTxg">
                <ownedParameter xmi:id="_cCtwa2YXEe6uL7xt-YnTxg" name="row">
