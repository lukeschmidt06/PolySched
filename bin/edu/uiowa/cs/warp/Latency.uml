              <ownedAttribute xmi:id="_cCSSe2YXEe6uL7xt-YnTxg" name="wfm" visibility="package" type="_b9IFq2YXEe6uL7xt-YnTxg" association="_cDBSU2YXEe6uL7xt-YnTxg"/>
