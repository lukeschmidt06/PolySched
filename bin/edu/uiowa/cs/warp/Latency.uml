            <packagedElement xmi:type="uml:Class" xmi:id="_b9eq-2YXEe6uL7xt-YnTxg" name="ReliabilityVisualization">
              <ownedComment xmi:id="_rwBAPJXmEe6MhezhJ-iEDA">
                <body>ReliabilityVisualization creates the visualizations for
the reliability analysis of the WARP program. &lt;p>

CS2820 Spring 2023 Project: Implement this class to create
the file visualization that is requested in Warp.

@author sgoddard
 *</body>
              </ownedComment>
              <generalization xmi:id="_cBmV9GYXEe6uL7xt-YnTxg" general="_b9stYGYXEe6uL7xt-YnTxg"/>
