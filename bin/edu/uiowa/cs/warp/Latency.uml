                <ownedParameter xmi:id="_gHYJIJXmEe6MhezhJ-iEDA" type="_b9GQcmYXEe6uL7xt-YnTxg" direction="return"/>
              </ownedOperation>
              <ownedOperation xmi:id="_gHYJI5XmEe6MhezhJ-iEDA" name="createTitle" method="_gHxKt5XmEe6MhezhJ-iEDA">
                <ownedComment xmi:id="_OSYWYZYOEe6MhezhJ-iEDA">
                  <body>This method creates a title using the name of the workload to be used as the graph name. It should be private since it is only called
  * within this file, but it is public so that we can create tests for this helper method.
  *
  * Return: A formatted string that includes the name of the workload as the graph name.
  *</body>
                </ownedComment>
                <ownedParameter xmi:id="_gHkWYJXmEe6MhezhJ-iEDA" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
              </ownedOperation>
