              <ownedComment xmi:id="_rwC1YJXmEe6MhezhJ-iEDA">
                <body>@author sgoddard
 *</body>
              </ownedComment>
              <ownedAttribute xmi:id="_cCfGzGYXEe6uL7xt-YnTxg" name="UNKNOWN" visibility="private" isLeaf="true" isStatic="true" isReadOnly="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCfGzWYXEe6uL7xt-YnTxg" value="&quot;unknown&quot;"/>
              </ownedAttribute>
              <ownedAttribute xmi:id="_cCfGzmYXEe6uL7xt-YnTxg" name="UNUSED" isLeaf="true" isStatic="true" isReadOnly="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
