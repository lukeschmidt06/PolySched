              <ownedOperation xmi:id="_cB7tIWYXEe6uL7xt-YnTxg" name="CodeFragment" visibility="package" method="_cCmbjGYXEe6uL7xt-YnTxg">
                <eAnnotations xmi:id="_cB7tJmYXEe6uL7xt-YnTxg" source="http://www.eclipse.org/uml2/2.0.0/UML">
                  <details xmi:id="_cB7tJ2YXEe6uL7xt-YnTxg" key="create"/>
                </eAnnotations>
                <ownedComment xmi:id="_rv_yFZXmEe6MhezhJ-iEDA">
                  <body>Constructor generates DSL instructions to transmit
	 * the data over edges using the coordinator and channel
	 * to determine the type of instruction and delta to 
	 * determine the number of times each instructions must
	 * be attempted.
	 * 
	 * @param delta
	 * @param edges
	 * @param coordinators
	 * @param channel</body>
                </ownedComment>
                <ownedParameter xmi:id="_cB7tImYXEe6uL7xt-YnTxg" name="delta">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cB7tI2YXEe6uL7xt-YnTxg" name="edges" type="_cBOigWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cB7tJGYXEe6uL7xt-YnTxg" name="coordinators" type="_cBOigWYXEe6uL7xt-YnTxg"/>
                <ownedParameter xmi:id="_cB7tJWYXEe6uL7xt-YnTxg" name="channel">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
                </ownedParameter>
                <ownedParameter xmi:id="_cB7tKGYXEe6uL7xt-YnTxg" type="_b9CmE2YXEe6uL7xt-YnTxg" direction="return"/>
              </ownedOperation>
