                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCaOTGYXEe6uL7xt-YnTxg" value="&quot;.ra&quot;"/>
              </ownedAttribute>
