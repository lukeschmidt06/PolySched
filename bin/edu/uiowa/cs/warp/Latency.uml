              </ownedAttribute>
              <ownedAttribute xmi:id="_cCfG0GYXEe6uL7xt-YnTxg" name="PUSH" isLeaf="true" isStatic="true" isReadOnly="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                <defaultValue xmi:type="uml:LiteralString" xmi:id="_cCfG0WYXEe6uL7xt-YnTxg" value="&quot;push&quot;"/>
